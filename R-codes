mean_or_na <- function(x) {
  x <- suppressWarnings(as.numeric(x))
  if (all(is.na(x))) return(NA_real_)
  mean(x, na.rm = TRUE)
}

cv_percent <- function(x) {
  x <- suppressWarnings(as.numeric(x))
  if (sum(!is.na(x)) < 2 || mean(x, na.rm = TRUE) == 0) return(NA_real_)
  100 * sd(x, na.rm = TRUE) / mean(x, na.rm = TRUE)
}

format_p <- function(p) {
  dplyr::case_when(
    is.na(p) ~ "NA",
    p < 0.001 ~ "<0.001",
    TRUE ~ formatC(p, format = "f", digits = 3)
  )
}

save_plot <- function(plot_object, file_stem, width, height) {
  pdf_device <- if (capabilities("cairo")) grDevices::cairo_pdf else grDevices::pdf

  ggsave(
    file.path(results_dir, paste0(file_stem, ".pdf")),
    plot_object,
    width = width,
    height = height,
    units = "in",
    device = pdf_device,
    bg = "white"
  )

  ggsave(
    file.path(results_dir, paste0(file_stem, ".png")),
    plot_object,
    width = width,
    height = height,
    units = "in",
    dpi = 600,
    bg = "white"
  )
}

