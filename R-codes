      !is.na(Liver) & !is.na(Spleen) & Liver > 0 & Spleen > 0,
      "MDV-positive",
      "Control/ND"
    ),
    SystemicBurden = if_else(
      MDV_status == "MDV-positive",
      sqrt(Liver * Spleen),
      NA_real_
    )
  )

