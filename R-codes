mixed_data <- association_data %>%
  mutate(
    log10_MDV_centered = log10_MDV - mean(log10_MDV, na.rm = TRUE),
    Tissue = relevel(factor(Tissue), ref = "Liver")
  )

fit_one_cytokine <- function(cytokine_code) {
  d <- mixed_data %>%
    filter(Cytokine == cytokine_code) %>%
    droplevels()

  control_settings <- lmerControl(
    optimizer = "bobyqa",
    optCtrl = list(maxfun = 200000)
  )

  full_model <- lmer(
    log2_Expression ~ log10_MDV_centered + Tissue + (1 | SampleName),
    data = d,
    REML = FALSE,
    control = control_settings
  )

  reduced_model <- lmer(
    log2_Expression ~ Tissue + (1 | SampleName),
    data = d,
    REML = FALSE,
    control = control_settings
  )

  interaction_model <- lmer(
    log2_Expression ~ log10_MDV_centered * Tissue + (1 | SampleName),
    data = d,
    REML = FALSE,
    control = control_settings
  )

  load_lrt <- anova(reduced_model, full_model, refit = FALSE)
  interaction_lrt <- anova(full_model, interaction_model, refit = FALSE)

  beta <- unname(fixef(full_model)["log10_MDV_centered"])
  beta_se <- sqrt(vcov(full_model)[
    "log10_MDV_centered",
    "log10_MDV_centered"
  ])
  beta_low <- beta - 1.96 * beta_se
  beta_high <- beta + 1.96 * beta_se

  tissue_term <- grep(
    "^Tissue",
    names(fixef(full_model)),
    value = TRUE
  )[1]
  tissue_beta <- unname(fixef(full_model)[tissue_term])
  tissue_se <- sqrt(vcov(full_model)[tissue_term, tissue_term])
  tissue_low <- tissue_beta - 1.96 * tissue_se
  tissue_high <- tissue_beta + 1.96 * tissue_se

  variance_table <- as.data.frame(VarCorr(full_model))
  random_variance <- variance_table$vcov[
    variance_table$grp == "SampleName"
  ][1]
  residual_variance <- sigma(full_model)^2
  icc <- random_variance / (random_variance + residual_variance)

  interaction_term <- grep(
    "log10_MDV_centered.*Tissue|Tissue.*log10_MDV_centered",
    names(fixef(interaction_model)),
    value = TRUE
  )[1]

  result <- tibble(
    Cytokine = cytokine_code,
    CytokineLabel = unname(cytokine_labels[cytokine_code]),
    Beta_log2_per_10fold_MDV = beta,
    SE = beta_se,
    Beta_95CI_low = beta_low,
    Beta_95CI_high = beta_high,
    Fold_change_per_10fold_MDV = 2^beta,
    Fold_change_95CI_low = 2^beta_low,
    Fold_change_95CI_high = 2^beta_high,
    LRT_chi_square = load_lrt$Chisq[2],
    LRT_p_value = load_lrt$`Pr(>Chisq)`[2],
    Spleen_vs_liver_beta_log2 = tissue_beta,
    Spleen_vs_liver_fold_change = 2^tissue_beta,
    Spleen_effect_95CI_low = 2^tissue_low,
    Spleen_effect_95CI_high = 2^tissue_high,
    Random_intercept_variance = random_variance,
    Residual_variance = residual_variance,
    ICC = icc,
    AIC = AIC(full_model),
    BIC = BIC(full_model),
    Singular = isSingular(full_model, tol = 1e-5),
    Interaction_beta_log2 = unname(
      fixef(interaction_model)[interaction_term]
    ),
    Interaction_LRT_chi_square = interaction_lrt$Chisq[2],
    Interaction_p_value = interaction_lrt$`Pr(>Chisq)`[2]
  )

  list(
    result = result,
    full_model = full_model,
    interaction_model = interaction_model
  )
}

model_fits <- setNames(
  lapply(cytokines, fit_one_cytokine),
